{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://playrewards.com/flow-engine/schema/executable-flow-bundle-1.0.schema.json",
  "title": "Executable Flow Bundle 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "flowIdentity", "flowDefinition", "componentContracts", "protocolSchemas", "externalScopeSchemas"],
  "properties": {
    "contractVersion": { "const": "1.0" },
    "flowIdentity": { "$ref": "#/$defs/flowIdentity" },
    "flowDefinition": { "$ref": "#/$defs/flowDefinition" },
    "componentContracts": { "type": "object", "propertyNames": { "$ref": "#/$defs/nonBlankString" }, "additionalProperties": { "$ref": "#/$defs/componentContract" } },
    "protocolSchemas": { "type": "object", "propertyNames": { "$ref": "#/$defs/nonBlankString" }, "additionalProperties": { "$ref": "#/$defs/protocolSchema" } },
    "externalScopeSchemas": { "type": "object", "propertyNames": { "$ref": "#/$defs/nonBlankString" }, "additionalProperties": { "$ref": "#/$defs/protocolSchema" } },
    "bundleHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "trust": { "type": "object", "properties": { "issuer": {"type": "string"}, "keyId": {"type": "string"}, "signature": {"type": "string"} }, "additionalProperties": false }
  },
  "$defs": {
    "nonBlankString": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "flowIdentity": { "type": "object", "required": ["tenantId", "flowId", "version"], "properties": { "tenantId": {"$ref": "#/$defs/nonBlankString"}, "flowId": {"$ref": "#/$defs/nonBlankString"}, "version": {"$ref": "#/$defs/nonBlankString"} }, "additionalProperties": false },
    "flowDefinition": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "nodes", "edges"], "properties": { "schemaVersion": {"const": "2.0"}, "nodes": {"type": "array", "items": {"$ref": "#/$defs/flowNode"}}, "edges": {"type": "array", "items": {"$ref": "#/$defs/flowEdge"}} } },
    "flowNode": { "type": "object", "additionalProperties": false, "required": ["id", "componentCode", "nodeCode", "nodeName", "config"], "properties": { "id": {"$ref": "#/$defs/nonBlankString"}, "componentCode": {"$ref": "#/$defs/nonBlankString"}, "nodeCode": {"$ref": "#/$defs/nonBlankString"}, "nodeName": {"$ref": "#/$defs/nonBlankString"}, "config": {"type": "object", "propertyNames": {"$ref": "#/$defs/nonBlankString"}} } },
    "flowEdge": { "type": "object", "additionalProperties": false, "required": ["id", "sourceNodeId", "targetNodeId", "sourcePort", "targetPort"], "properties": { "id": {"$ref": "#/$defs/nonBlankString"}, "sourceNodeId": {"$ref": "#/$defs/nonBlankString"}, "targetNodeId": {"$ref": "#/$defs/nonBlankString"}, "sourcePort": {"$ref": "#/$defs/nonBlankString"}, "targetPort": {"$ref": "#/$defs/nonBlankString"} } },
    "componentContract": { "type": "object", "additionalProperties": false, "required": ["componentCode", "componentType", "configSchema", "inputSlots", "outputSlots", "capabilities"], "properties": { "componentCode": {"$ref": "#/$defs/nonBlankString"}, "componentType": {"enum": ["START", "END", "IF", "MERGE", "SWITCH", "PARALLEL", "LOOP", "VARIABLE", "SCRIPT", "SUB_FLOW", "LOCK", "HTTP", "BUSINESS"]}, "executorRef": {"$ref": "#/$defs/nonBlankString"}, "configSchema": {"type": "object", "propertyNames": {"$ref": "#/$defs/nonBlankString"}}, "inputSlots": {"type": "object", "propertyNames": {"$ref": "#/$defs/nonBlankString"}, "additionalProperties": {"$ref": "#/$defs/protocolSchema"}}, "outputSlots": {"type": "object", "propertyNames": {"$ref": "#/$defs/nonBlankString"}, "additionalProperties": {"$ref": "#/$defs/protocolSchema"}}, "capabilities": {"type": "object", "additionalProperties": false, "required": ["effect", "supportsTrial", "streaming", "retryable", "maxConcurrency"], "properties": {"effect": {"enum": ["PURE", "IDEMPOTENT", "SIDE_EFFECT"]}, "supportsTrial": {"type": "boolean"}, "streaming": {"type": "boolean"}, "retryable": {"type": "boolean"}, "maxConcurrency": {"type": "integer", "minimum": 1}}} } },
    "protocolSchema": { "type": "object", "additionalProperties": false, "required": ["code", "version", "schema"], "properties": { "code": {"$ref": "#/$defs/nonBlankString"}, "version": {"$ref": "#/$defs/nonBlankString"}, "schema": {"type": "object", "propertyNames": {"$ref": "#/$defs/nonBlankString"}} } }
  }
}
